<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="dashboard-shell">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="avatar-badge" id="sidebarAvatar">U</div>
        <div>
          <strong id="sidebarName">Usuario</strong><br />
          <small id="sidebarRole">user</small>
        </div>
      </div>

      <nav class="side-nav" aria-label="Navegación lateral">
        <a class="side-link active" href="/dashboard"><span>Dashboard</span><span>→</span></a>
        <a class="side-link" href="/profile"><span>Perfil</span><span>→</span></a>
      </nav>
    </aside>

    <main class="content-area">
      <div class="top-panel">
        <div>
          <div class="page-kicker">Bienvenido</div>
          <h1 class="page-title">Hola, <span id="userName">Usuario</span></h1>
        </div>
        <button id="logoutButton" class="secondary-btn" type="button">Cerrar sesión</button>
      </div>

      <div class="summary-grid">
        <article class="summary-card">
          <span class="label">Rol</span>
          <strong id="roleInfo">—</strong>
        </article>
        <article class="summary-card">
          <span class="label">Edad</span>
          <strong id="ageInfo">—</strong>
        </article>
        <article class="summary-card">
          <span class="label">Registro</span>
          <strong id="createdInfo">—</strong>
        </article>
        <article class="summary-card">
          <span class="label">Token</span>
          <strong id="tokenInfo">Activa</strong>
        </article>
      </div>

      <div class="card-panel profile-layout">
        <div class="profile-header">
          <div class="profile-avatar" id="profileAvatar">U</div>
          <div>
            <h2 style="margin: 0; font-size: 1.5rem;">Tu perfil</h2>
            <p id="profileEmail" style="margin: 8px 0 0; color: var(--muted);">Cargando...</p>
          </div>
        </div>

        <div class="field-row">
          <div class="input-wrap">
            <label for="fullName">Nombre completo</label>
            <input id="fullName" type="text" value="Cargando..." readonly />
          </div>
          <div class="input-wrap">
            <label for="phoneField">Teléfono</label>
            <input id="phoneField" type="text" value="Cargando..." readonly />
          </div>
        </div>

        <div class="field-row">
          <div class="input-wrap">
            <label for="birthField">Fecha de nacimiento</label>
            <input id="birthField" type="text" value="Cargando..." readonly />
          </div>
          <div class="input-wrap">
            <label for="statusField">Estado</label>
            <input id="statusField" type="text" value="Conectado" readonly />
          </div>
        </div>

        <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px;">
          <a class="primary-btn" href="/profile">Editar perfil</a>
          <a class="secondary-btn" href="/">Volver al inicio</a>
        </div>
      </div>
    </main>

    <script src="/js/auth.js"></script>
    <script>
      (async function () {
        const token = await requireAuth();
        if (!token) return;

        const roles = getRolesFromToken(token);
        const isAdmin = roles.includes('admin');

        const response = await fetch('/api/users/me', {
          headers: { Authorization: `Bearer ${token}` }
        });

        if (response.status === 401) {
          clearSession();
          window.location.href = '/signIn';
          return;
        }

        if (response.status === 403) {
          window.location.href = '/403';
          return;
        }

        const user = await response.json();
        const initials = ((user.name || 'U') + ' ' + (user.lastName || '')).trim() || 'U';
        const displayName = `${user.name || ''} ${user.lastName || ''}`.trim() || 'Usuario';
        const birthDate = user.birthdate ? new Date(user.birthdate) : null;
        const age = birthDate ? new Date(Date.now() - birthDate.getTime()).getUTCFullYear() - 1970 : 'N/A';

        document.getElementById('userName').textContent = user.name || 'Usuario';
        document.getElementById('sidebarName').textContent = displayName;
        document.getElementById('sidebarRole').textContent = (user.roles || ['user']).join(', ');
        document.getElementById('sidebarAvatar').textContent = initials.charAt(0).toUpperCase();
        document.getElementById('profileAvatar').textContent = initials.charAt(0).toUpperCase();
        document.getElementById('profileEmail').textContent = user.email || 'Sin email';
        document.getElementById('roleInfo').textContent = (user.roles || ['user']).join(', ');
        document.getElementById('ageInfo').textContent = age === 'N/A' ? 'N/A' : `${age} años`;
        document.getElementById('createdInfo').textContent = user.createdAt ? new Date(user.createdAt).toLocaleDateString() : 'Sin fecha';
        document.getElementById('fullName').value = displayName;
        document.getElementById('phoneField').value = user.phoneNumber || 'Sin teléfono';
        document.getElementById('birthField').value = birthDate ? birthDate.toLocaleDateString() : 'Sin fecha';

        if (isAdmin) {
          const adminLink = document.createElement('a');
          adminLink.className = 'side-link';
          adminLink.href = '/admin';
          adminLink.innerHTML = '<span>Administración</span><span>→</span>';
          document.querySelector('.side-nav').appendChild(adminLink);
        }

        document.getElementById('logoutButton').addEventListener('click', () => {
          clearSession();
          window.location.href = '/signIn';
        });
      })();
    </script>
  </body>
</html>
