<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <nav>
      <div class="nav-wrapper">
        <div class="container">
          <a href="/admin" class="brand-logo">Admin</a>
          <ul id="nav-mobile" class="right hide-on-med-and-down">
            <li><a href="/dashboard">Dashboard</a></li>
            <li><button id="logoutButton" class="btn-flat white-text">Cerrar sesión</button></li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container" style="padding-top: 30px;">
      <h4>Dashboard administrador</h4>
      <div class="card-panel">
        <div class="table-wrapper">
          <table class="striped highlight responsive-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Apellidos</th>
                <th>Email</th>
                <th>Teléfono</th>
                <th>Fecha nacimiento</th>
                <th>Edad</th>
                <th>Dirección</th>
                <th>URL</th>
                <th>Rol</th>
                <th>Fecha registro</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody id="usersTableBody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <div id="userDetailModal" class="modal">
      <div class="modal-content">
        <h4>Detalle de usuario</h4>
        <div id="userDetailContent"></div>
      </div>
      <div class="modal-footer">
        <a href="#" class="modal-close waves-effect waves-green btn-flat">Cerrar</a>
      </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
    <script src="/js/auth.js"></script>
    <script>
      (async function () {
        const token = await requireAuth();
        if (!token) return;

        const roles = getRolesFromToken(token);
        if (!roles.includes('admin')) {
          window.location.href = '/403';
          return;
        }

        async function loadUsers() {
          const response = await fetch('/api/users', {
            headers: { Authorization: `Bearer ${token}` }
          });

          if (response.status === 401) {
            clearSession();
            window.location.href = '/signIn';
            return;
          }

          if (response.status === 403) {
            window.location.href = '/403';
            return;
          }

          const users = await response.json();
          const tbody = document.getElementById('usersTableBody');
          tbody.innerHTML = users.map((user) => `
            <tr>
              <td>${user._id}</td>
              <td>${user.name || ''}</td>
              <td>${user.lastName || ''}</td>
              <td>${user.email || ''}</td>
              <td>${user.phoneNumber || ''}</td>
              <td>${user.birthdate ? new Date(user.birthdate).toLocaleDateString() : ''}</td>
              <td>${user.age ?? ''}</td>
              <td>${user.adress || ''}</td>
              <td>${user.url_profile || ''}</td>
              <td>${(user.roles || []).join(', ')}</td>
              <td>${user.createdAt ? new Date(user.createdAt).toLocaleDateString() : ''}</td>
              <td><button class="btn-small waves-effect waves-light view-user" data-user-id="${user._id}">Ver</button></td>
            </tr>
          `).join('');

          document.querySelectorAll('.view-user').forEach((button) => {
            button.addEventListener('click', async () => {
              const userId = button.getAttribute('data-user-id');
              const res = await fetch(`/api/users/${userId}`, {
                headers: { Authorization: `Bearer ${token}` }
              });
              const user = await res.json();
              document.getElementById('userDetailContent').innerHTML = `
                <p><strong>Nombre:</strong> ${user.name}</p>
                <p><strong>Apellidos:</strong> ${user.lastName}</p>
                <p><strong>Email:</strong> ${user.email}</p>
                <p><strong>Teléfono:</strong> ${user.phoneNumber}</p>
                <p><strong>Fecha de nacimiento:</strong> ${user.birthdate ? new Date(user.birthdate).toLocaleDateString() : ''}</p>
                <p><strong>Edad:</strong> ${user.age}</p>
                <p><strong>Dirección:</strong> ${user.adress || ''}</p>
                <p><strong>URL perfil:</strong> ${user.url_profile || ''}</p>
                <p><strong>Roles:</strong> ${(user.roles || []).join(', ')}</p>
                <p><strong>Fecha de registro:</strong> ${user.createdAt ? new Date(user.createdAt).toLocaleString() : ''}</p>
              `;
              const modal = document.getElementById('userDetailModal');
              M.Modal.getInstance(modal)?.destroy();
              M.Modal.init(modal, { dismissible: true });
              const instance = M.Modal.getInstance(modal) || M.Modal.init(modal)[0];
              if (instance) instance.open();
            });
          });
        }

        document.getElementById('logoutButton').addEventListener('click', () => {
          clearSession();
          window.location.href = '/signIn';
        });

        await loadUsers();
      })();
    </script>
  </body>
</html>
