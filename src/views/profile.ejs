<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="dashboard-shell">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="avatar-badge" id="sidebarAvatar">U</div>
        <div>
          <strong id="sidebarName">Usuario</strong><br />
          <small id="sidebarRole">user</small>
        </div>
      </div>

      <nav class="side-nav" aria-label="Navegación lateral">
        <a class="side-link" href="/dashboard"><span>Dashboard</span><span>→</span></a>
        <a class="side-link active" href="/profile"><span>Perfil</span><span>→</span></a>
      </nav>
    </aside>

    <main class="content-area">
      <div class="top-panel">
        <div>
          <div class="page-kicker">Configuración</div>
          <h1 class="page-title">Perfil de usuario</h1>
        </div>
        <button id="logoutButton" class="secondary-btn" type="button">Cerrar sesión</button>
      </div>

      <div class="card-panel profile-layout">
        <div class="profile-header">
          <div class="profile-avatar" id="profileAvatar">U</div>
          <div>
            <h2 style="margin: 0; font-size: 1.4rem;" id="headerTitle">Mi cuenta</h2>
            <p id="headerEmail" style="margin: 8px 0 0; color: var(--muted);">Cargando...</p>
          </div>
        </div>

        <form id="profileForm" class="form-grid" novalidate>
          <div class="field-row">
            <div class="input-wrap">
              <label for="name">Nombre</label>
              <input id="name" name="name" type="text" required />
            </div>
            <div class="input-wrap">
              <label for="lastName">Apellidos</label>
              <input id="lastName" name="lastName" type="text" required />
            </div>
          </div>

          <div class="field-row">
            <div class="input-wrap">
              <label for="email">Correo electrónico</label>
              <input id="email" name="email" type="email" required />
            </div>
            <div class="input-wrap">
              <label for="phoneNumber">Teléfono</label>
              <input id="phoneNumber" name="phoneNumber" type="text" required />
            </div>
          </div>

          <div class="field-row">
            <div class="input-wrap">
              <label for="birthdate">Fecha de nacimiento</label>
              <input id="birthdate" name="birthdate" type="date" required />
            </div>
            <div class="input-wrap">
              <label for="url_profile">URL de perfil</label>
              <input id="url_profile" name="url_profile" type="url" />
            </div>
          </div>

          <div class="field-row">
            <div class="input-wrap">
              <label for="adress">Dirección</label>
              <input id="adress" name="adress" type="text" />
            </div>
            <div class="input-wrap password">
              <label for="newPassword">Nueva contraseña (opcional)</label>
              <input id="newPassword" name="password" type="password" />
              <button type="button" class="show-password" data-toggle-password="newPassword">Mostrar</button>
            </div>
          </div>

          <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <button type="submit" class="primary-btn" id="saveButton">Guardar cambios</button>
            <a class="secondary-btn" href="/dashboard">Volver</a>
          </div>
          <div id="message" class="form-message error"></div>
        </form>
      </div>
    </main>

    <script src="/js/auth.js"></script>
    <script>
      (async function () {
        const token = await requireAuth();
        if (!token) return;

        function showToast(type, message) {
          const element = document.getElementById('message');
          element.className = `form-message ${type === 'error' ? 'error' : 'success'}`;
          element.textContent = message;
        }

        document.querySelectorAll('[data-toggle-password]').forEach((toggle) => {
          toggle.addEventListener('click', () => {
            const input = document.getElementById(toggle.dataset.togglePassword);
            const visible = input.type === 'text';
            input.type = visible ? 'password' : 'text';
            toggle.textContent = visible ? 'Mostrar' : 'Ocultar';
          });
        });

        const response = await fetch('/api/users/me', {
          headers: { Authorization: `Bearer ${token}` }
        });

        if (response.status === 401) {
          clearSession();
          window.location.href = '/signIn';
          return;
        }

        const user = await response.json();
        const initials = ((user.name || 'U') + ' ' + (user.lastName || '')).trim() || 'U';
        const fullName = `${user.name || ''} ${user.lastName || ''}`.trim() || 'Usuario';

        document.getElementById('sidebarName').textContent = fullName;
        document.getElementById('sidebarRole').textContent = (user.roles || ['user']).join(', ');
        document.getElementById('headerTitle').textContent = fullName;
        document.getElementById('headerEmail').textContent = user.email || 'Sin email';
        document.getElementById('profileAvatar').textContent = initials.charAt(0).toUpperCase();
        document.getElementById('sidebarAvatar').textContent = initials.charAt(0).toUpperCase();

        document.getElementById('name').value = user.name || '';
        document.getElementById('lastName').value = user.lastName || '';
        document.getElementById('email').value = user.email || '';
        document.getElementById('phoneNumber').value = user.phoneNumber || '';
        document.getElementById('birthdate').value = user.birthdate ? new Date(user.birthdate).toISOString().slice(0, 10) : '';
        document.getElementById('url_profile').value = user.url_profile || '';
        document.getElementById('adress').value = user.adress || '';

        document.getElementById('profileForm').addEventListener('submit', async (event) => {
          event.preventDefault();
          const payload = {
            name: document.getElementById('name').value.trim(),
            lastName: document.getElementById('lastName').value.trim(),
            email: document.getElementById('email').value.trim(),
            phoneNumber: document.getElementById('phoneNumber').value.trim(),
            birthdate: document.getElementById('birthdate').value,
            url_profile: document.getElementById('url_profile').value.trim(),
            adress: document.getElementById('adress').value.trim()
          };

          const password = document.getElementById('newPassword').value;
          if (password) payload.password = password;

          const saveButton = document.getElementById('saveButton');
          saveButton.disabled = true;
          saveButton.textContent = 'Guardando...';

          try {
            const response = await fetch('/api/users/me', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
              body: JSON.stringify(payload)
            });

            const data = await response.json();
            if (!response.ok) {
              showToast('error', data.message || 'No se pudo guardar el perfil.');
              return;
            }

            showToast('success', 'Perfil actualizado correctamente.');
            document.getElementById('headerTitle').textContent = `${data.name || ''} ${data.lastName || ''}`.trim() || 'Mi cuenta';
            document.getElementById('headerEmail').textContent = data.email || 'Sin email';
          } catch (error) {
            showToast('error', 'Error al guardar el perfil.');
          } finally {
            saveButton.disabled = false;
            saveButton.textContent = 'Guardar cambios';
          }
        });

        document.getElementById('logoutButton').addEventListener('click', () => {
          clearSession();
          window.location.href = '/signIn';
        });
      })();
    </script>
  </body>
</html>
