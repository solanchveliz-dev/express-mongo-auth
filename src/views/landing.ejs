<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <header class="topbar">
      <div class="container topbar-inner">
        <a href="/" class="brand" aria-label="Express Auth home">
          <span class="brand-mark">E</span>
          <span>Express Auth</span>
        </a>

        <nav class="nav-links" aria-label="Navegación principal">
          <a href="#features">Características</a>
          <a href="#how-it-works">Cómo probar</a>
          <a href="#api">API</a>
        </nav>

        <div class="nav-actions">
          <a class="ghost-btn" href="/signIn">Iniciar sesión</a>
          <a class="primary-btn" href="/signUp">Crear cuenta</a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-inner">
          <div>
            <div class="eyebrow">JWT • Roles • MongoDB Atlas</div>
            <h1>Autenticación segura con JWT, roles y MongoDB Atlas</h1>
            <p>
              Una base sólida para manejar login seguro, usuarios con permisos, despliegue automático y
              acceso controlado con un flujo profesional y claro para aplicaciones web avanzadas.
            </p>

            <div class="hero-actions">
              <a class="primary-btn" href="/signUp">Comenzar ahora</a>
              <a class="secondary-btn" href="#how-it-works">Ver demo</a>
            </div>

            <div class="hero-trust">
              <span>JWT con expiración</span>
              <span>bcrypt + validación</span>
              <span>Render + GitHub Actions</span>
            </div>
          </div>

          <div class="hero-card" aria-label="Mockup de autenticación">
            <div class="mock-window">
              <div class="window-toolbar">
                <span class="window-dot"></span>
                <span class="window-dot"></span>
                <span class="window-dot"></span>
              </div>

              <div class="token-card">
                <strong>jwt payload</strong><br />
                {<br />
                &nbsp;&nbsp;"sub": "64df...e13",<br />
                &nbsp;&nbsp;"roles": ["admin"],<br />
                &nbsp;&nbsp;"iat": 1715595242,<br />
                &nbsp;&nbsp;"exp": 1715598842<br />
                }
              </div>
            </div>

            <div class="dashboard-mini">
              <strong>Estado del sistema</strong>
              <div class="mini-row">
                <div class="mini-stat">
                  <span class="label">Sesión</span>
                  <strong>Activa</strong>
                </div>
                <div class="mini-stat">
                  <span class="label">Rol</span>
                  <strong>Admin</strong>
                </div>
                <div class="mini-stat">
                  <span class="label">DB</span>
                  <strong>Atlas</strong>
                </div>
                <div class="mini-stat">
                  <span class="label">Uptime</span>
                  <strong>99.9%</strong>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="features" class="section">
        <div class="container">
          <h2 class="section-title" style="text-align: center;">Características principales</h2>
          <p class="section-intro">Todo lo necesario para una autenticación web segura, revisable y lista para producción.</p>

          <div class="feature-grid">
            <article class="card">
              <div class="feature-icon">🔐</div>
              <h3>JWT con expiración</h3>
              <p>Tokens firmados con expiración configurable para proteger rutas y gestionar sesiones de forma segura.</p>
            </article>
            <article class="card">
              <div class="feature-icon">🛡️</div>
              <h3>Contraseñas con bcrypt</h3>
              <p>Se aplica hashing seguro para evitar almacenar credenciales en texto plano dentro del sistema.</p>
            </article>
            <article class="card">
              <div class="feature-icon">🧑‍💼</div>
              <h3>Control por roles</h3>
              <p>Usuarios y administradores con acceso diferenciado según el rol dentro de la aplicación.</p>
            </article>
            <article class="card">
              <div class="feature-icon">☁️</div>
              <h3>MongoDB Atlas</h3>
              <p>Persistencia en la nube con su propia base de datos para entornos académicos y productivos.</p>
            </article>
            <article class="card">
              <div class="feature-icon">🚀</div>
              <h3>Render + CI/CD</h3>
              <p>Despliegue en Render y pipeline con GitHub Actions para automatizar el release de la app.</p>
            </article>
            <article class="card">
              <div class="feature-icon">📦</div>
              <h3>Arquitectura clara</h3>
              <p>Routes → controllers → services → repositories → models para mantener una base ordenada y escalable.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="how-it-works" class="section" style="background: white;">
        <div class="container">
          <h2 class="section-title" style="text-align: center;">Cómo funciona</h2>
          <div class="step-grid">
            <article class="card step-item">
              <div class="step-number">1</div>
              <h3>Regístrate</h3>
              <p>Crea tu usuario con correo, contraseña segura y datos básicos del perfil.</p>
            </article>
            <article class="card step-item">
              <div class="step-number">2</div>
              <h3>Inicia sesión</h3>
              <p>El backend valida tus credenciales y devuelve un token JWT válido.</p>
            </article>
            <article class="card step-item">
              <div class="step-number">3</div>
              <h3>Recibe tu token</h3>
              <p>El token se guarda en sessionStorage y se usa para autorizar cada pedido.</p>
            </article>
            <article class="card step-item">
              <div class="step-number">4</div>
              <h3>Accede según tu rol</h3>
              <p>Los usuarios normales ven su dashboard y los admins gestionan la aplicación.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <h2 class="section-title" style="text-align: center;">Pruébalo ahora</h2>
          <div class="demo-grid" style="margin-top: 28px;">
            <article class="card demo-card">
              <div class="demo-meta">
                <span class="demo-label">Usuario</span>
                <strong>usuario@demo.com</strong>
                <span>Usuario#2026</span>
              </div>
              <button class="copy-btn" data-copy="usuario@demo.com|Usuario#2026">Copiar</button>
            </article>
            <article class="card demo-card">
              <div class="demo-meta">
                <span class="demo-label">Administrador</span>
                <strong>admin@local.test</strong>
                <span>Admin@123</span>
              </div>
              <button class="copy-btn" data-copy="admin@local.test|Admin@123">Copiar</button>
            </article>
          </div>
        </div>
      </section>

      <section id="api" class="section" style="background: white;">
        <div class="container">
          <h2 class="section-title" style="text-align: center;">Endpoints principales</h2>
          <div class="api-table-wrap" style="margin-top: 26px;">
            <table class="api-table">
              <thead>
                <tr>
                  <th>Método</th>
                  <th>Ruta</th>
                  <th>Acceso</th>
                  <th>Descripción</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><span class="method-badge method-get">GET</span></td>
                  <td><code>/health</code></td>
                  <td>Público</td>
                  <td>Estado del servidor y conexión a la base de datos.</td>
                </tr>
                <tr>
                  <td><span class="method-badge method-post">POST</span></td>
                  <td><code>/api/auth/signUp</code></td>
                  <td>Público</td>
                  <td>Registro de usuarios con validaciones y JWT.</td>
                </tr>
                <tr>
                  <td><span class="method-badge method-post">POST</span></td>
                  <td><code>/api/auth/signIn</code></td>
                  <td>Público</td>
                  <td>Login y obtención del token JWT.</td>
                </tr>
                <tr>
                  <td><span class="method-badge method-get">GET</span></td>
                  <td><code>/api/users/me</code></td>
                  <td>Token</td>
                  <td>Perfil del usuario autenticado.</td>
                </tr>
                <tr>
                  <td><span class="method-badge method-put">PUT</span></td>
                  <td><code>/api/users/me</code></td>
                  <td>Token</td>
                  <td>Actualización del perfil propio.</td>
                </tr>
                <tr>
                  <td><span class="method-badge method-get">GET</span></td>
                  <td><code>/api/users</code></td>
                  <td>Admin</td>
                  <td>Listado completo de usuarios.</td>
                </tr>
                <tr>
                  <td><span class="method-badge method-delete">DELETE</span></td>
                  <td><code>/api/users/:id</code></td>
                  <td>Admin</td>
                  <td>Eliminación de un usuario por su identificador.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <h2 class="section-title" style="text-align: center;">Estado del sistema</h2>
          <div class="status-panel" style="margin-top: 26px;">
            <div>
              <div class="status-pill"><span class="status-dot"></span> API en línea</div>
              <p id="healthText" style="margin: 10px 0 0; color: var(--muted);">Verificando conectividad…</p>
            </div>
            <button class="primary-btn" id="refreshHealth">Actualizar</button>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <div>
          <strong>Solanch Veliz</strong><br />
          <span>Laboratorio 08 · Tecsup 2026</span>
        </div>
        <div>
          <a href="https://github.com/solanchveliz-dev/express-mongo-auth" target="_blank" rel="noreferrer">GitHub del proyecto</a>
        </div>
      </div>
    </footer>

    <script src="/js/auth.js"></script>
    <script>
      const healthText = document.getElementById('healthText');
      const refreshHealth = document.getElementById('refreshHealth');

      async function loadHealth() {
        try {
          const response = await fetch('/health');
          const data = await response.json();
          const connected = data?.database?.connected === true || data?.database?.mode === 'memory';
          const modeText = data?.database?.mode === 'memory' ? 'modo memoria' : 'base de datos conectada';
          healthText.textContent = connected ? `API en línea • ${modeText}` : 'API no disponible';
        } catch (error) {
          healthText.textContent = 'No se pudo verificar la API';
        }
      }

      refreshHealth.addEventListener('click', loadHealth);
      loadHealth();

      document.querySelectorAll('[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          const value = button.getAttribute('data-copy');
          try {
            await navigator.clipboard.writeText(value.replace('|', ' / '));
            const previous = button.textContent;
            button.textContent = 'Copiado';
            setTimeout(() => { button.textContent = previous; }, 1400);
          } catch (error) {
            button.textContent = 'Error';
          }
        });
      });
    </script>
  </body>
</html>
