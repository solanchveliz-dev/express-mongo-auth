{
  "info": {
    "name": "DAWA08-express-auth (JWT)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://express-auth-veliz.onrender.com"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "GET health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "POST signUp (registro)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/signUp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Solanch\",\n  \"lastName\": \"Veliz\",\n  \"email\": \"solanch.veliz@tecsup.edu.pe\",\n  \"password\": \"Veliz#2026\",\n  \"phoneNumber\": \"987654321\",\n  \"birthdate\": \"2004-05-10\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) pm.collectionVariables.set('userToken', d.token);",
                  "if (d.user) pm.collectionVariables.set('userId', d.user._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST signIn (login usuario)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/signIn",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"solanch.veliz@tecsup.edu.pe\",\n  \"password\": \"Veliz#2026\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) pm.collectionVariables.set('userToken', d.token);",
                  "if (d.user) pm.collectionVariables.set('userId', d.user._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST signIn (login admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/signIn",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@local.test\",\n  \"password\": \"Admin@123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) pm.collectionVariables.set('adminToken', d.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Usuario (token user)",
      "item": [
        {
          "name": "GET /me (mi perfil)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "PUT /me (editar mi perfil)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/users/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"adress\": \"Lima, Perú\",\n  \"url_profile\": \"https://github.com/solanchveliz-dev\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Admin (token admin)",
      "item": [
        {
          "name": "GET listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "GET usuario por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "PUT editar usuario",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"912345678\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "DELETE eliminar usuario",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Errores (seguridad)",
      "item": [
        {
          "name": "401 sin token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "403 user intenta listar",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "401 login incorrecto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/signIn",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"solanch.veliz@tecsup.edu.pe\",\n  \"password\": \"Incorrecta1#\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "400 password débil",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/signUp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test\",\n  \"lastName\": \"Debil\",\n  \"email\": \"debil@tecsup.edu.pe\",\n  \"password\": \"123\",\n  \"phoneNumber\": \"999\",\n  \"birthdate\": \"2000-01-01\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "409 email repetido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/signUp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Solanch\",\n  \"lastName\": \"Veliz\",\n  \"email\": \"solanch.veliz@tecsup.edu.pe\",\n  \"password\": \"Veliz#2026\",\n  \"phoneNumber\": \"987654321\",\n  \"birthdate\": \"2004-05-10\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ]
}